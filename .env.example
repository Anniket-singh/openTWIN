# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/opentwin
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Authentication (JWT)
JWT_SECRET=your_strong_jwt_secret_min_32_characters_long
JWT_EXPIRATION=900000

# Google Gemini API (AI Embeddings & Generation)
# Required for chunk embeddings and RAG answers
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_GENERATION_MODEL=gemini-3.5-flash

# Qdrant Vector Database
# For Qdrant Cloud:
#   QDRANT_HOST=your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
#   QDRANT_GRPC_PORT=6334
#   QDRANT_API_KEY=your_qdrant_api_key
#   QDRANT_USE_TLS=true
# For Local Qdrant:
#   QDRANT_HOST=localhost
#   QDRANT_GRPC_PORT=6334
#   QDRANT_API_KEY=
#   QDRANT_USE_TLS=false
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_USE_TLS=false
QDRANT_COLLECTION_NAME=open_twin_knowledge
QDRANT_VECTOR_DIMENSION=768

# CORS (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGIN=http://localhost:5173,https://open-twin-frontend.vercel.app

# Server Port
PORT=8080

# Logging
SHOW_SQL=false
FORMAT_SQL=false